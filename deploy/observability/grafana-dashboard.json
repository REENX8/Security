{
  "title": "Thai Phishing Detector — Backend",
  "uid": "phish-backend",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Model ready",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "targets": [{ "expr": "phish_model_ready", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache size",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "phish_cache_size", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Check rate by label (per s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(phish_checks_total[5m])) by (label)", "legendFormat": "{{label}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "/check latency p50 / p95 / p99 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(phish_check_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(phish_check_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(phish_check_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(phish_checks_total{cached=\"true\"}[5m])) / clamp_min(sum(rate(phish_checks_total[5m])), 1e-9)", "legendFormat": "hit ratio", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "WHOIS/TLS lookup fallback rate (per s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(rate(phish_network_timeout_total[5m])) by (kind)", "legendFormat": "{{kind}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "External feed ingestion (per s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(rate(phish_feed_urls_ingested_total[15m])) by (source)", "legendFormat": "{{source}}", "refId": "A" }
      ]
    }
  ]
}
