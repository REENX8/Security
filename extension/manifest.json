{
  "manifest_version": 3,
  "name": "รู้ทัน — Thai Phishing Detector",
  "short_name": "รู้ทัน",
  "version": "1.2.1",
  "description": "รู้ทัน — ตรวจจับเว็บไซต์ปลอม/ฟิชชิงที่แอบอ้างหน่วยงานราชการไทย (.go.th) และสถานศึกษา (.ac.th) แบบเรียลไทม์",
  "author": "RuThan (รู้ทัน) contributors",
  "homepage_url": "https://github.com/reenx8/security",
  "minimum_chrome_version": "108",

  "permissions": [
    "webNavigation",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "รู้ทัน — ตรวจสอบความปลอดภัยเว็บไซต์",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["warning.html", "warning.css", "warning.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "thai-phishing-detector@reenx8.github.io",
      "strict_min_version": "121.0"
    }
  }
}
